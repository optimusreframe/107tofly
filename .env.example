# 107toFly — Environment variables
# Copy to .env (auto-managed by Lovable Cloud — do not edit .env by hand).
# Public (exposed to client) — must be VITE_-prefixed:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...   # Supabase anon/publishable key (safe to expose)
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-only (NEVER expose to client). Set via Lovable Cloud secrets manager.
# SUPABASE_SERVICE_ROLE_KEY=...                # used inside server functions only
# LOVABLE_API_KEY=...                          # for Lovable AI Gateway (FlyCoach)
